{
  "name": "dmarc-able",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node server.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "node --check worker.mjs && node --check server.mjs && node --check scripts/build.mjs",
    "security:check": "node scripts/security-check.mjs",
    "check:cloudflare": "wrangler deploy --dry-run --outdir dist-worker",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.158.0"
  }
}
